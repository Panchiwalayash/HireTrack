PORT=5000
NODE_ENV=development

# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role secret for backend API server to bypass RLS and perform authoritative DB changes:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# AI Intelligence API Keys (Optional - Heuristic Admissions Engine used if not provided)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key

# Or OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key
